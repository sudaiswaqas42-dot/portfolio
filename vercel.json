{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://portfolio-backend-production-9c68.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://portfolio-backend-production-9c68.up.railway.app/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
