{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "dev:client": "vite --config frontend/vite.config.js",
    "dev:server": "node --watch backend/server/server.cjs",
    "start": "node backend/server/server.cjs",
    "db:init": "node backend/server/init_db.cjs",
    "test": "node --test backend/tests/*.test.cjs",
    "verify:api": "node backend/scripts/verify-api.cjs",
    "verify:site": "node backend/scripts/verify-site.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.1.18",
    "lottie-web": "^5.12.2",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
